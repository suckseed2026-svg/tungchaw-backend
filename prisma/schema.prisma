generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum BusinessStatus {
  PENDING
  TRIAL
  ACTIVE
  SUSPENDED
  EXPIRED
  CANCELLED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum StockMovementType {
  OPENING_STOCK
  PURCHASE
  SALE
  SALE_RETURN
  PURCHASE_RETURN
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  DAMAGE
  EXPIRED
  THEFT
}

enum PurchaseStatus {
  DRAFT
  RECEIVED
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  UPI
  CARD
  CHEQUE
  CREDIT_NOTE
  OTHER
}

model Business {
  id       String         @id @default(uuid())
  name     String
  code     String         @unique
  status   BusinessStatus @default(PENDING)
  phone    String?
  email    String?
  address  String?
  timezone String         @default("Asia/Kolkata")
  currency String         @default("INR")

  branches         Branch[]
  memberships      BusinessMember[]
  roles            Role[]
  categories       Category[]
  units            Unit[]
  brands           Brand[]
  products         Product[]
  suppliers        Supplier[]
  purchases        Purchase[]
  branchStocks     BranchStock[]
  stockMovements   StockMovement[]
  purchasePayments PurchasePayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Branch {
  id         String  @id @default(uuid())
  businessId String
  name       String
  code       String
  phone      String?
  address    String?
  isActive   Boolean @default(true)

  business          Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  memberAssignments MemberBranch[]
  stocks            BranchStock[]
  stockMovements    StockMovement[]
  purchases         Purchase[]
  purchasePayments  PurchasePayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, code])
  @@index([businessId])
  @@index([businessId, isActive])
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  phone        String?
  passwordHash String
  status       UserStatus @default(ACTIVE)

  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?

  memberships             BusinessMember[]
  stockMovements          StockMovement[]
  createdPurchases        Purchase[]
  createdPurchasePayments PurchasePayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BusinessMember {
  id         String           @id @default(uuid())
  businessId String
  userId     String
  status     MembershipStatus @default(INVITED)
  isOwner    Boolean          @default(false)
  joinedAt   DateTime?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  roleAssignments   MemberRole[]
  branchAssignments MemberBranch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, userId])
  @@index([businessId])
  @@index([userId])
  @@index([businessId, status])
}

model Role {
  id          String  @id @default(uuid())
  businessId  String
  name        String
  code        String
  description String?
  isSystem    Boolean @default(false)
  isActive    Boolean @default(true)

  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  members     MemberRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, code])
  @@index([businessId])
  @@index([businessId, isActive])
}

model Permission {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  category    String
  description String?
  isActive    Boolean @default(true)

  roles RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([isActive])
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  constraints Json?

  createdAt DateTime @default(now())

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model MemberRole {
  id       String @id @default(uuid())
  memberId String
  roleId   String

  member BusinessMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role   Role           @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@unique([memberId, roleId])
  @@index([memberId])
  @@index([roleId])
}

model MemberBranch {
  id       String @id @default(uuid())
  memberId String
  branchId String

  member BusinessMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  branch Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@unique([memberId, branchId])
  @@index([memberId])
  @@index([branchId])
}

model Category {
  id          String  @id @default(uuid())
  businessId  String
  name        String
  code        String
  description String?
  isActive    Boolean @default(true)

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, code])
  @@index([businessId])
  @@index([businessId, isActive])
}

model Unit {
  id          String  @id @default(uuid())
  businessId  String
  name        String
  code        String
  symbol      String
  description String?
  isActive    Boolean @default(true)

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, code])
  @@index([businessId])
  @@index([businessId, isActive])
}

model Brand {
  id          String  @id @default(uuid())
  businessId  String
  name        String
  code        String
  description String?
  isActive    Boolean @default(true)

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, code])
  @@index([businessId])
  @@index([businessId, isActive])
}

model Supplier {
  id         String @id @default(uuid())
  businessId String

  name        String
  code        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  gstNumber   String?
  notes       String?

  isActive Boolean @default(true)

  business         Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchases        Purchase[]
  purchasePayments PurchasePayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, code])
  @@index([businessId])
  @@index([businessId, isActive])
  @@index([businessId, name])
}

model Product {
  id         String  @id @default(uuid())
  businessId String
  categoryId String?
  unitId     String
  brandId    String?

  name        String
  code        String
  barcode     String?
  description String?

  costPrice    Decimal @default(0) @db.Decimal(18, 2)
  sellingPrice Decimal @default(0) @db.Decimal(18, 2)

  trackStock Boolean @default(true)
  isActive   Boolean @default(true)

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  unit     Unit      @relation(fields: [unitId], references: [id], onDelete: Restrict)
  brand    Brand?    @relation(fields: [brandId], references: [id], onDelete: SetNull)

  branchStocks   BranchStock[]
  stockMovements StockMovement[]
  purchaseItems  PurchaseItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, code])
  @@unique([businessId, barcode])
  @@index([businessId])
  @@index([businessId, categoryId])
  @@index([businessId, unitId])
  @@index([businessId, brandId])
  @@index([businessId, isActive])
}

model Purchase {
  id          String  @id @default(uuid())
  businessId  String
  branchId    String
  supplierId  String
  createdById String?

  invoiceNumber         String
  supplierInvoiceNumber String?
  purchaseDate          DateTime
  status                PurchaseStatus @default(DRAFT)

  subtotal       Decimal @default(0) @db.Decimal(18, 2)
  discountAmount Decimal @default(0) @db.Decimal(18, 2)
  taxAmount      Decimal @default(0) @db.Decimal(18, 2)
  otherCharges   Decimal @default(0) @db.Decimal(18, 2)
  totalAmount    Decimal @default(0) @db.Decimal(18, 2)

  notes String?

  receivedAt  DateTime?
  cancelledAt DateTime?

  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  supplier  Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  items    PurchaseItem[]
  payments PurchasePayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, invoiceNumber])
  @@index([businessId])
  @@index([branchId])
  @@index([supplierId])
  @@index([createdById])
  @@index([businessId, status])
  @@index([businessId, purchaseDate])
  @@index([businessId, branchId])
  @@index([businessId, supplierId])
}

model PurchaseItem {
  id         String @id @default(uuid())
  purchaseId String
  productId  String
  lineNumber Int

  quantity Decimal @db.Decimal(18, 3)
  unitCost Decimal @db.Decimal(18, 2)

  discountAmount Decimal @default(0) @db.Decimal(18, 2)
  taxAmount      Decimal @default(0) @db.Decimal(18, 2)
  lineTotal      Decimal @db.Decimal(18, 2)

  batchNumber    String?
  manufacturedAt DateTime?
  expiryDate     DateTime?

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([purchaseId, lineNumber])
  @@index([purchaseId])
  @@index([productId])
  @@index([expiryDate])
  @@index([purchaseId, productId])
  @@index([batchNumber])
}

model PurchasePayment {
  id          String  @id @default(uuid())
  businessId  String
  purchaseId  String
  supplierId  String
  branchId    String
  createdById String?

  paymentDate   DateTime
  amount        Decimal       @db.Decimal(18, 2)
  paymentMethod PaymentMethod

  referenceNumber String?
  notes           String?

  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchase  Purchase @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  supplier  Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([purchaseId])
  @@index([supplierId])
  @@index([branchId])
  @@index([createdById])
  @@index([businessId, paymentDate])
  @@index([businessId, supplierId, paymentDate])
  @@index([businessId, purchaseId])
}

model BranchStock {
  id         String @id @default(uuid())
  businessId String
  branchId   String
  productId  String

  quantity     Decimal @default(0) @db.Decimal(18, 3)
  reorderLevel Decimal @default(0) @db.Decimal(18, 3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, productId])
  @@index([businessId])
  @@index([branchId])
  @@index([productId])
  @@index([businessId, branchId])
  @@index([businessId, productId])
}

model StockMovement {
  id         String            @id @default(uuid())
  businessId String
  branchId   String
  productId  String
  type       StockMovementType

  quantityBefore Decimal @db.Decimal(18, 3)
  quantityChange Decimal @db.Decimal(18, 3)
  quantityAfter  Decimal @db.Decimal(18, 3)

  referenceType String?
  referenceId   String?
  reason        String?
  notes         String?
  createdById   String?

  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdBy User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([businessId])
  @@index([branchId])
  @@index([productId])
  @@index([createdById])
  @@index([businessId, branchId])
  @@index([businessId, branchId, productId])
  @@index([referenceType, referenceId])
  @@index([createdAt])
}
